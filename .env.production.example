# Copia fuera del repositorio y pasa su ruta con docker compose --env-file.
APP_ENV_FILE=C:/Users/welli/selfhost/lucaplan/production.env
TAILSCALE_IP=100.101.76.33
TLS_CERT_DIR=C:/Users/welli/selfhost/lucaplan/certs
# Usa una contraseña aleatoria hexadecimal (sin caracteres que requieran URL-encoding).
POSTGRES_PASSWORD=

# Conserva los valores de producción: cambiarlos invalida sesiones o tokens cifrados.
BETTER_AUTH_SECRET=
BANCOCHILE_ENC_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=consumers
# Opcional: fija el usuario que posee los buzones; si falta se elige el primer buzón activo.
OUTLOOK_USER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Conserva las demás variables de producción que utilices, excepto RAILWAY_* / SEED_PR_*.
