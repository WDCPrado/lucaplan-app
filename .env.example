# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lucaplan?schema=public"

# Better Auth — genera el secret con: npx @better-auth/cli secret
# El plugin OAuth requiere secret >=32 caracteres y URL canónica; HTTPS en producción.
# Su recurso MCP será <origen de BETTER_AUTH_URL>/api/mcp. No usa Host de la petición.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Acceso por código: clave solo en servidor. No requiere plantilla remota.
RESEND_API_KEY=""
# Opcional: el dominio del remitente debe estar verificado en Resend.
RESEND_FROM="Luca Plan <no-reply@lucaplan.cl>"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Llave maestra para cifrar secretos de conexiones (refresh token de Outlook). OPCIONAL: si no la
# pones, se genera una aleatoria y se guarda en ./.bancochile-key (gitignored). Si la pones, debe
# tener >=32 caracteres de alta entropía. El nombre es histórico: no lo cambies con datos cifrados.
# BANCOCHILE_ENC_KEY=""

# Web Push (notificaciones en Android, iOS 16.4+ instalada y Windows). OPCIONAL: sin estas claves
# la app funciona igual, solo que no ofrece ni envía notificaciones.
# Genera el par una vez con: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que exige VAPID para que el push service pueda reportar abusos.
VAPID_SUBJECT="mailto:tu@correo.com"

# Outlook personal -> notificaciones de Banco de Chile (Microsoft Graph, solo Mail.Read).
# Guía completa: docs/email-connection-outlook.md
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT="consumers"
# OUTLOOK_REDIRECT_URI="http://localhost:3005/api/email-connection/callback"
# OUTLOOK_WEBHOOK_URL="https://app.example.com/api/email-connection/webhook"
# OUTLOOK_RENEW_SECRET=""