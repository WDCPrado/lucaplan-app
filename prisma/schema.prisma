// Schema de Prisma. Los modelos de auth (user, session, account, verification)
// los genera la CLI de Better Auth: `npx @better-auth/cli generate`.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../arch/v1/infrastructure/database/prisma/generated"
}

model User {
  id                       String              @id
  name                     String
  email                    String
  emailVerified            Boolean             @default(false)
  image                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  role                     String?
  banned                   Boolean?            @default(false)
  banReason                String?
  banExpires               DateTime?
  sessions                 Session[]
  accounts                 Account[]
  oauthClient_userId       OAuthClient[]       @relation("oauthClient_userId")
  oauthRefreshToken_userId OAuthRefreshToken[] @relation("oauthRefreshToken_userId")
  oauthAccessToken_userId  OAuthAccessToken[]  @relation("oauthAccessToken_userId")
  oauthConsent_userId      OAuthConsent[]      @relation("oauthConsent_userId")
  settings                 UserSetting[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                          String              @id
  expiresAt                   DateTime
  token                       String
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  ipAddress                   String?
  userAgent                   String?
  userId                      String
  user                        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy              String?
  oauthRefreshToken_sessionId OAuthRefreshToken[] @relation("oauthRefreshToken_sessionId")
  oauthAccessToken_sessionId  OAuthAccessToken[]  @relation("oauthAccessToken_sessionId")

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Dominio financiero (Luca Plan) ──────────────────────────────────────────────
// Desacoplado del modelo de auth: la relación con el usuario es por columna `userId`
// (String, = User.id) SIN @relation, para no tocar los modelos que genera Better Auth.
// Las relaciones entre modelos propios sí llevan FK real. Montos en Decimal(18,2);
// moneda ISO 4217 en `currency`. La "caja activa" y el uso por categoría son fórmulas
// (ver arch/v1/application/finance-use-cases), no columnas.

// Umbrales de aviso del presupuesto mensual, configurables. GLOBAL a propósito: sin relación a
// usuario ni a mes — es una preferencia de la app, no un dato financiero. Puede haber N (50%, 80%,
// 100%, 120%…); se avisa el más alto que el gasto CRUZA con un movimiento.
model BudgetAlert {
  id        String   @id @default(uuid())
  percent   Int      @unique // % del límite global; único para no avisar dos veces lo mismo
  createdAt DateTime @default(now())

  @@map("budget_alert")
}

// Preferencias sueltas de la app (clave → valor), globales como los umbrales: no cuelgan de un
// usuario ni de un mes. Hoy solo `due_days` (días de anticipación del aviso de vencimientos).
// Clave-valor para no pagar una migración por cada preferencia escalar que aparezca.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

// Preferencias POR USUARIO (apariencia: nivel de vidrio, tema), clave → valor como AppSetting.
// Qué claves existen y cómo se leen lo decide arch/v1/application/user-use-cases/user-settings-use-cases.
model UserSetting {
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_setting")
}

// Suscripción Web Push de un dispositivo (endpoint del push service del navegador). Un usuario
// puede tener varias (teléfono, escritorio). El endpoint es la identidad: si el navegador la
// renueva llega uno nuevo y el viejo muere con 404/410, momento en que se borra.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // clave pública del cliente (base64url)
  auth      String // secreto de autenticación del cliente (base64url)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

model Bank {
  id               String             @id @default(uuid())
  userId           String
  name             String
  isActive         Boolean            @default(true)
  provider         String             @default("manual") // manual | clave de un banco del catálogo (bancochile, …)
  connectionMethod String? // email (solo bancos conectados); null = manual
  externalLinkId   String? // ponytail: columna legada sin uso; dropear en una migración aparte
  linkToken        String? // ponytail: columna legada sin uso; dropear en una migración aparte
  lastSyncedAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  accounts         FinancialAccount[]
  emailBankLink    EmailBankLink?

  @@index([userId])
  @@index([externalLinkId])
  @@map("bank")
}

model FinancialAccount {
  id             String              @id @default(uuid())
  userId         String
  bankId         String
  bank           Bank                @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name           String
  accountType    String // checking | savings | credit_card | credit_line | wallet | investment
  currency       String // ISO 4217: CLP, USD
  balance        Decimal             @default(0) @db.Decimal(18, 2) // permite negativo (sobregiro) en checking
  overdraftLimit Decimal             @default(0) @db.Decimal(18, 2)
  color          String? // presentación: color de la tarjeta (opcional)
  cardLast4      String? // últimos 4 dígitos de la tarjeta; obligatorio en app para checking/credit_card
  status         String              @default("active")
  provider       String              @default("manual") // manual | bancochile (solo lectura)
  externalId     String? // id de la cuenta en el banco (número de cuenta / últimos 4)
  lastSyncedAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   Transaction[]
  cards          Card[]
  buckets        BalanceBucket[]
  incomes        Income[]
  recurring      RecurringTemplate[]
  installments   InstallmentPlan[]

  @@unique([userId, externalId])
  @@index([userId, bankId])
  @@map("financial_account")
}

// Tarjeta física de una cuenta (débito de la corriente; 1+ crédito de una cuenta de crédito).
// Solo se crea con identidad real del banco (últimos 4). Solo lectura cuando provider != manual.
model Card {
  id         String           @id @default(uuid())
  userId     String
  accountId  String
  account    FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardType   String // debito | credito
  cardLast4  String
  brand      String? // marca/presentación (ej. "Visa Signature")
  provider   String           @default("manual") // manual | bancochile
  externalId String? // máscara/id de la tarjeta en el banco (**** 2120)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  buckets    BalanceBucket[]

  @@unique([accountId, externalId])
  @@index([accountId])
  @@map("card")
}

// Saldo/cupo como MEDICIÓN mutable (used/available/limit + asOf), no el libro contable. Pertenece a
// una cuenta y, si aplica, a una tarjeta. Distinta moneda ⇒ buckets separados; nunca se suman.
model BalanceBucket {
  id           String           @id @default(uuid())
  userId       String
  accountId    String
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardId       String?
  card         Card?            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind         String // cash | overdraft | credit_national | credit_international
  currency     String // ISO 4217: CLP, USD
  limitAmount  Decimal          @default(0) @db.Decimal(18, 2)
  used         Decimal          @default(0) @db.Decimal(18, 2) // usado = deuda (overdraft/crédito)
  available    Decimal          @default(0) @db.Decimal(18, 2)
  reconciledAt DateTime? // corte bancario propio; no se adelanta al proyectar movimientos
  asOf         DateTime? // marca de tiempo del dato del banco
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions Transaction[]

  @@index([accountId, kind])
  @@map("balance_bucket")
}

// BUZÓN de correo autorizado (Outlook vía Microsoft Graph). Es la unidad de autorización: un token,
// un estado delta y una suscripción por correo, sin importar cuántos bancos alimente. El refresh
// token va CIFRADO (AES-256-GCM con llave derivada con propósito propio, distinto del de
// credenciales bancarias); nunca sale al cliente ni a logs. Los cuerpos de correo NO se persisten:
// solo el evento financiero extraído.
model EmailMailbox {
  id                    String          @id @default(uuid())
  userId                String
  emailProvider         String          @default("outlook") // proveedor de correo (solo outlook en v1)
  emailAddress          String
  status                String          @default("active") // active | reauth_required | error
  refreshTokenEnc       String // ciphertext+tag AES-256-GCM (base64)
  refreshTokenIv        String // nonce (base64)
  deltaLink             String? // estado delta de Graph (recuperación de notificaciones perdidas)
  subscriptionId        String? // suscripción webhook de Graph (null sin webhook HTTPS)
  subscriptionExpiresAt DateTime?
  lastSyncedAt          DateTime?
  lastError             String? // último error operativo, sin PII ni tokens
  discardedCount        Int             @default(0) // correos que ningún banco del catálogo reclama
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  links                 EmailBankLink[]

  @@unique([userId, emailAddress])
  @@index([subscriptionId])
  @@map("email_mailbox")
}

// VÍNCULO entre un buzón y un banco: lo que ese correo alimenta. Un buzón tiene N vínculos (bancos
// distintos) y un banco puede venir de N buzones (personal/empresa), pero NUNCA dos veces del mismo
// buzón: el enrutado por remitente no tendría cómo decidir a cuál imputar el movimiento.
model EmailBankLink {
  id                      String       @id @default(uuid())
  mailboxId               String
  mailbox                 EmailMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  userId                  String
  bankProvider            String // clave del banco en el catálogo (bancochile, …)
  label                   String? // etiqueta que distingue este origen ("Empresa"); obligatoria desde el 2º vínculo del mismo banco
  bankId                  String?      @unique // banco creado tras validar candidatos; null durante el setup
  bank                    Bank?        @relation(fields: [bankId], references: [id], onDelete: SetNull)
  status                  String       @default("pending_setup") // pending_setup | active
  skippedCount            Int          @default(0) // correos de ESTE banco que no pudieron convertirse en movimiento
  lastBalanceReconciledAt DateTime? // fecha/hora del snapshot manual vigente (la proyección parte aquí)
  createdAt               DateTime     @default(now()) // fija el cierre de la carga inicial de este banco
  updatedAt               DateTime     @updatedAt

  @@unique([mailboxId, bankProvider])
  @@index([userId])
  @@map("email_bank_link")
}

// Método de conexión ACTIVO por (usuario, banco, buzón): la fila única impide a nivel de DB tener
// dos métodos a la vez para el mismo banco desde el mismo origen, sin bloquear el mismo banco desde
// otro correo. Se reclama al conectar y se libera al desconectar.
model BankConnectionMethod {
  id           String   @id @default(uuid())
  userId       String
  bankProvider String // bancochile
  mailboxId    String // buzón de origen
  method       String // email
  createdAt    DateTime @default(now())

  @@unique([userId, bankProvider, mailboxId])
  @@map("bank_connection_method")
}

// Categoría GLOBAL del usuario, compartida entre todos los meses. El límite NO vive aquí:
// es por mes (ver CategoryLimit). Lo único que cambia mes a mes es el límite; la categoría no.
model Category {
  id           String                     @id @default(uuid())
  userId       String
  name         String
  type         String                     @default("expense") // income (ingreso) | expense (gasto)
  icon         String? // presentación: icono lucide o emoji (opcional)
  color        String? // presentación: color del anillo (opcional)
  description  String? // contexto para la categorización con IA (opcional); no afecta cálculos
  // Ritmo de gasto (hoy / esta semana) en la tarjeta de la categoría. Se apaga en las que no se
  // gastan de a poco —una suscripción se cobra un día del mes— y ahí el ritmo solo hace ruido.
  paceEnabled  Boolean                    @default(true)
  isActive     Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  limits       CategoryLimit[]
  transactions Transaction[]
  corrections  CategorizationCorrection[]
  incomes      Income[]
  recurring    RecurringTemplate[]
  installments InstallmentPlan[]

  @@unique([userId, name])
  @@index([userId])
  @@map("category")
}

// Fuente de ingreso mensual del usuario (sueldo, arriendo, freelance...), creada a mano. Semilla del
// límite global del presupuesto (Σ ingresos activos). El botón "generar" materializa el ingreso del
// mes como una Transaction (credit) en la cuenta destino (que NO es de crédito). `incomeId` en la
// Transaction deja el gancho para la recurrencia automática futura. Relación con el usuario por
// columna `userId` (convención: el dominio financiero no toca el User que regenera Better Auth).
model Income {
  id           String           @id @default(uuid())
  userId       String
  accountId    String // cuenta destino (no credit_card/credit_line): donde entra el ingreso
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   String // categoría type=income
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  currency     String // ISO 4217: coincide con la moneda de la cuenta destino
  dayOfMonth   Int // día de ingreso esperado (1–31)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions Transaction[]
  amounts      IncomeAmount[]
  plans        IncomePlan[]

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@map("income")
}

// Activación y fin de vigencia independientes; la identidad y los cobros siguen compartidos.
model IncomePlan {
  incomeId   String
  income     Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  mode       String
  isActive   Boolean @default(true)
  endedYear  Int?
  endedMonth Int?

  @@id([incomeId, mode])
  @@map("income_plan")
}

// Monto por modo y período. Hereda el último previo del mismo modo; antes del primero no existe.
model IncomeAmount {
  id        String   @id @default(uuid())
  incomeId  String
  income    Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  mode      String
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([incomeId, mode, year, month])
  @@index([incomeId, mode, year, month])
  @@map("income_amount")
}

// Corrección de categorización: memoria por usuario (texto normalizado del movimiento → categoría
// elegida + nota "porqué"). Se registra al categorizar a mano y se inyecta como contexto de la IA.
// A lo más una por (usuario, dirección, texto); la última gana. No entra en ningún cálculo.
model CategorizationCorrection {
  id             String   @id @default(uuid())
  userId         String
  direction      String // debit | credit (el mismo texto puede ser compra y reembolso)
  normalizedText String
  sampleText     String // descripción original de ejemplo (UI/prompt)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  note           String? // el "porqué" del usuario (opcional)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, direction, normalizedText])
  @@index([userId, direction])
  @@map("categorization_correction")
}

// Límite de una categoría para un mes concreto. El mes sin registro hereda el último previo (carry).
model CategoryLimit {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mode      String
  year        Int
  month       Int
  limitAmount Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, mode, year, month])
  @@index([categoryId, mode, year, month])
  @@map("category_limit")
}

// Presupuesto del mes: una fila por usuario+mes con el límite global (cuánto puede presupuestarse
// en total entre las categorías de gasto). Las categorías NO se asocian por FK: son globales con
// límite por mes (CategoryLimit). El mes sin registro hereda el último previo (carry), igual que
// los límites; sin ningún registro, el límite global está "no definido" (distinto de 0).
model MonthlyBudget {
  id          String   @id @default(uuid())
  userId      String
  mode      String
  year        Int
  month       Int
  globalLimit Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, mode, year, month])
  @@map("monthly_budget")
}

// Plantilla de gasto recurrente: ejecuta 0..N movimientos reales. Al abrirse un período materializa
// su Transaction como `pending` (gasto comprometido, no cuenta como gastado) y el cargo real del
// banco la confirma, reconocido por descripción normalizada + monto dentro de ±tolerancePct del
// baseAmount. La categoría es obligatoria y manda: un movimiento vinculado a una plantilla nunca
// pasa por la IA. Mismo patrón que Income, pero para gastos.
model RecurringTemplate {
  id           String           @id @default(uuid())
  userId       String
  accountId    String // cuenta del cargo: el comprometido del período se materializa ahí
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   String // obligatoria: toda ejecución usa ESTA categoría, nunca la IA
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label        String // nombre visible/editable; no afecta el match
  description  String // clave de match: se compara normalizada (normalizeMovementText); inmutable desde el front
  direction    String // debit | credit
  baseAmount   Decimal          @db.Decimal(18, 2) // monto esperado; el real puede variar dentro del rango
  currency     String // coincide con la moneda de la cuenta
  tolerancePct Int              @default(10) // ± % sobre baseAmount que define el rango de match
  periodicity  String           @default("monthly") // monthly | biweekly | yearly
  dayOfMonth   Int? // día de ejecución (monthly/yearly); en meses cortos cae al último día
  startDate    DateTime         @db.Date // ancla de los períodos (imprescindible en biweekly)
  // Fin de vigencia; null = indefinida (nunca termina). El último cobro es el del período que cae
  // en esta fecha o antes; después la plantilla queda finalizada y no puede reactivarse sin correrla.
  endDate      DateTime?        @db.Date
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions Transaction[]

  @@index([userId, isActive])
  @@index([accountId])
  @@index([categoryId])
  @@map("recurring_template")
}

// Deuda repartida en N cuotas. `kind` elige CÓMO se entera el sistema de que una cuota se pagó,
// y de ahí sale toda la asimetría: en `card` (compra con tarjeta) el plan CREA el movimiento de
// cada cuota, porque la compra ya entró completa el día que ocurrió (queda neutralizada) y el
// correo del pago trae el total de la factura; en `loan` (crédito de consumo) el correo de la
// cuota ya genera el gasto real, así que el plan solo lo ADOPTA — crearlo también lo duplicaría.
model InstallmentPlan {
  id                  String            @id @default(uuid())
  userId              String
  kind                String // card | loan — elige el disparador; inmutable tras crear
  accountId           String // card: la cuenta de crédito; loan: la cuenta desde la que se paga
  account             FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId          String // toda cuota usa ESTA categoría, nunca la IA
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Solo en `card`: la compra original, neutralizada (isInternal) y conservada para trazabilidad.
  sourceTransactionId String?           @unique
  sourceTransaction   Transaction?      @relation("InstallmentSource", fields: [sourceTransactionId], references: [id], onDelete: SetNull)
  description         String
  totalAmount         Decimal           @db.Decimal(18, 2) // capital, sin intereses del banco
  currency            String
  installmentsCount   Int
  startDate           DateTime          @db.Date // vencimiento de la cuota 1
  dayOfMonth          Int
  tolerancePct        Int               @default(10) // SOLO desempata entre planes loan; nunca rechaza
  completedAt         DateTime? // se cierra al saldarse la última cuota
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               InstallmentItem[]

  @@index([userId])
  @@index([accountId, kind, completedAt])
  @@index([categoryId])
  @@map("installment_plan")
}

model InstallmentItem {
  id             String          @id @default(uuid())
  planId         String
  plan           InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  index          Int // 1..N
  dueDate        DateTime        @db.Date
  amount         Decimal         @db.Decimal(18, 2) // card: definitivo; loan: estimación (el correo manda)
  // Cuota anterior a la conexión de correo: cuenta para el avance, pero no generó gasto en la app.
  // Inventarle un movimiento falsearía meses que el usuario ya dio por cerrados.
  paidOutsideApp Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transaction    Transaction?

  @@unique([planId, index])
  @@index([planId])
  @@map("installment_item")
}

model Transaction {
  id                      String             @id @default(uuid())
  userId                  String
  accountId               String
  account                 FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId              String?
  category                Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankReceivedAt          DateTime? // recepción original del aviso, no fecha de importación
  reconciliation          Json? // evidencia bancaria y valores originales; protege del reproceso de correo
  bucketId                String? // bucket/cupo al que corresponde (solo si el banco lo identifica sin ambigüedad)
  bucket                  BalanceBucket?     @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  incomeId                String? // fuente de ingreso que generó este movimiento (gancho para recurrencia); null en el resto
  income                  Income?            @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  reimbursementsPaid      ExpenseReimbursement[] @relation("ReimbursedExpense")
  reimbursementsReceived  ExpenseReimbursement[] @relation("ReimbursementCredit")
  // plantilla recurrente que materializó este movimiento; borrar la plantilla conserva lo confirmado
  recurringTemplateId     String?
  recurringTemplate       RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  periodKey               String? // período de la plantilla (YYYY-MM | YYYY | YYYY-Qnn): impone idempotencia por BD
  // Cuota de un plan que este movimiento salda. Único: es LA garantía de idempotencia del sistema
  // de cuotas — reprocesar un correo no puede producir un segundo movimiento para el mismo ítem.
  installmentItemId       String?            @unique
  installmentItem         InstallmentItem?   @relation(fields: [installmentItemId], references: [id], onDelete: SetNull)
  installmentPlanAsSource InstallmentPlan?   @relation("InstallmentSource")
  transactionDate         DateTime           @db.Date
  description             String
  amount                  Decimal            @db.Decimal(18, 2)
  currency                String
  direction               String // debit | credit
  status                  String             @default("confirmed") // confirmed | pending | reversed | duplicated
  pending                 Boolean            @default(false)
  isInternal              Boolean            @default(false) // transferencia/pago interno (traspaso, pago línea/tarjeta): NO cuenta en presupuesto
  reviewed                Boolean            @default(false) // el usuario ya decidió la categorización (creó/editó/categorizó, aunque la deje vacía); excluye del triage y de la IA. La IA y el sync NO lo marcan.
  externalId              String? // id del movimiento en el banco; null si es manual o snapshot (no facturado)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([accountId, externalId])
  @@unique([recurringTemplateId, periodKey]) // un movimiento por plantilla y período
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([bucketId])
  @@index([incomeId])
  @@index([recurringTemplateId])
  @@map("transaction")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

model OAuthClient {
  id                         String              @id
  clientId                   String              @unique
  clientSecret               String?
  disabled                   Boolean?            @default(false)
  skipConsent                Boolean?
  enableEndSession           Boolean?
  subjectType                String?
  scopes                     String[]
  userId                     String?
  user                       User?               @relation("oauthClient_userId", fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime?
  updatedAt                  DateTime?
  name                       String?
  uri                        String?
  icon                       String?
  contacts                   String[]
  tos                        String?
  policy                     String?
  softwareId                 String?
  softwareVersion            String?
  softwareStatement          String?
  redirectUris               String[]
  postLogoutRedirectUris     String[]
  tokenEndpointAuthMethod    String?
  grantTypes                 String[]
  responseTypes              String[]
  public                     Boolean?
  type                       String?
  requirePKCE                Boolean?
  referenceId                String?
  metadata                   Json?
  oauthRefreshToken_clientId OAuthRefreshToken[] @relation("oauthRefreshToken_clientId")
  oauthAccessToken_clientId  OAuthAccessToken[]  @relation("oauthAccessToken_clientId")
  oauthConsent_clientId      OAuthConsent[]      @relation("oauthConsent_clientId")

  @@index([userId])
  @@map("oauth_client")
}

model OAuthRefreshToken {
  id                         String             @id
  token                      String             @unique
  clientId                   String
  client                     OAuthClient        @relation("oauthRefreshToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId                  String?
  session                    Session?           @relation("oauthRefreshToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  userId                     String
  user                       User               @relation("oauthRefreshToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  referenceId                String?
  expiresAt                  DateTime
  createdAt                  DateTime
  revoked                    DateTime?
  authTime                   DateTime?
  scopes                     String[]
  oauthAccessToken_refreshId OAuthAccessToken[] @relation("oauthAccessToken_refreshId")

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauth_refresh_token")
}

model OAuthAccessToken {
  id          String             @id
  token       String             @unique
  clientId    String
  client      OAuthClient        @relation("oauthAccessToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?           @relation("oauthAccessToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?              @relation("oauthAccessToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  refreshId   String?
  refresh     OAuthRefreshToken? @relation("oauthAccessToken_refreshId", fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime
  scopes      String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OAuthConsent {
  id          String      @id
  clientId    String
  client      OAuthClient @relation("oauthConsent_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?       @relation("oauthConsent_userId", fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  scopes      String[]
  createdAt   DateTime
  updatedAt   DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// Idempotencia por actor y cliente. Solo hash de entrada y resultado; nunca tokens ni argumentos.
model PluginOperation {
  id          String    @id @default(uuid())
  userId      String
  clientId    String
  operationId String
  toolName    String
  inputHash   String
  status      String
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@unique([userId, clientId, operationId])
  @@index([userId, createdAt])
  @@map("plugin_operation")
}

// Corte persistente por usuario y cliente: reautorizar no revive JWT anteriores.
model PluginGrantRevocation {
  userId    String
  clientId  String
  revokedAt DateTime

  @@id([userId, clientId])
  @@map("plugin_grant_revocation")
}

// Compensación presupuestaria: el gasto y el abono bancarios permanecen intactos.
model ExpenseReimbursement {
  id           String      @id @default(uuid())
  userId       String
  expenseId    String
  expense      Transaction @relation("ReimbursedExpense", fields: [expenseId], references: [id], onDelete: Cascade)
  creditId     String
  credit       Transaction @relation("ReimbursementCredit", fields: [creditId], references: [id], onDelete: Cascade)
  amount       Decimal     @db.Decimal(18, 2)
  createdAt    DateTime    @default(now())

  @@unique([expenseId, creditId])
  @@index([userId, expenseId])
  @@index([creditId])
  @@map("expense_reimbursement")
}


// Recibo atómico de conciliación: token de previsualización + auditoría completa.
model BankReconciliation {
  id String @id @default(uuid())
  userId String
  accountId String
  token String
  input Json
  result Json
  createdAt DateTime @default(now())
  @@unique([userId, token])
  @@index([userId, accountId])
  @@map("bank_reconciliation")
}
