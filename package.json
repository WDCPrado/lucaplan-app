{
  "name": "lucaplan-app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "prisma migrate deploy && prisma generate && next dev -p 3005",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "setup:prisma": "prisma generate && prisma migrate deploy",
    "setup:db": "node scripts/setup-db.mjs",
    "migrate:db": "node scripts/migrate-db.mjs",
    "clone:db": "node scripts/clone-prod-db.mjs",
    "fix:recurring-keys": "node scripts/fix-recurring-keys.ts",
    "deploy:init": "node scripts/deploy-init.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"arch/**/*.test.ts\" \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "seed": "NODE_ENV=development node --env-file-if-exists=.env scripts/seed.ts",
    "seed:categories": "node --env-file-if-exists=.env scripts/seed-categories.ts",
    "create:account": "node --env-file-if-exists=.env scripts/create-account.ts",
    "sync:email": "node --env-file-if-exists=.env scripts/sync-email.ts",
    "notify:due": "node --env-file-if-exists=.env scripts/notify-due.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.33",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@ybouane/liquidglass": "1.0.3",
    "better-auth": "~1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.20.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.10.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
