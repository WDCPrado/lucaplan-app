# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lucaplan?schema=public"

# Modo landing-only (deploy público, ej. Railway): true = solo la landing es accesible,
# /login y el resto de rutas redirigen a / y los CTAs apuntan al repo de GitHub.
NEXT_PUBLIC_LANDING_ONLY="false"

# Better Auth — genera el secret con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"


OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini