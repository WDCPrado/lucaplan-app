# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lucaplan?schema=public"

# Better Auth — genera el secret con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Fintoc (agregación de datos). Usa TEST keys en desarrollo.
# - La secret key es server-only (NUNCA al cliente). La public key va al widget.
# - El webhook secret lo entrega Fintoc al crear el webhook en su dashboard.
NEXT_PUBLIC_FINTOC_PUBLIC_KEY=""
FINTOC_SECRET_KEY=""
FINTOC_WEBHOOK_SECRET=""

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini