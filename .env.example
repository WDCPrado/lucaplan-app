# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lucaplan?schema=public"

# Modo landing-only (deploy público, ej. Railway): true = solo la landing es accesible,
# /login y el resto de rutas redirigen a / y los CTAs apuntan al repo de GitHub.
NEXT_PUBLIC_LANDING_ONLY="false"

# Better Auth — genera el secret con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"


OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Banco de Chile — scraper local (auto-login RUT + clave; BCH no pide 2FA para consultar).
# La clave se guarda solo en TU .env (gitignored, tu máquina). Solo lectura.
BCH_RUT="12345678-9"
BCH_PASS=""
# Usuario de LucaPlan al que se importan los datos (para el cron). Usa email o id (uso personal: si
# hay un solo usuario, se resuelve solo).
BANCOCHILE_USER_EMAIL=""
# BANCOCHILE_USER_ID=""
# Perfil del navegador (cookies) — fuera de git. Por defecto ./.bancochile-profile
# BANCOCHILE_PROFILE_DIR=""
# BCH_HEADLESS="false"  # ponlo en false para VER el navegador al depurar el login
# Llave para cifrar la clave del banco. OPCIONAL: si no la pones, se genera una aleatoria y se guarda
# en ./.bancochile-key (gitignored). Si la pones, debe tener >=32 caracteres de alta entropía.
# BANCOCHILE_ENC_KEY=""